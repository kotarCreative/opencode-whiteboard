{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": ".",
      "options": {
        "boardUrl": "http://127.0.0.1:4317"
      }
    }
  ],
  "permissions": [
    {
      "action": "whiteboard_export_to_excalidraw_url",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
